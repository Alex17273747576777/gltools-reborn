<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PERMISO DE RED, DELIBERADAMENTE ACOTADO.

      La app sigue funcionando SIN red: perfiles, panel y lectura del teléfono no tocan
      internet. Este permiso existe sólo para la búsqueda OPCIONAL de la sección
      «Aprender» (buscar un dispositivo y ver sus datos). Con `red_segura.xml` no hay
      ningún dominio de confianza ni tráfico en claro permitido, así que en la práctica
      el sistema no puede abrir conexiones: lo que no esté en la app, no se descarga.
      Si algún día se quiere cerrar del todo, se borra esta línea y ya está.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notificaciones: sólo para avisar de la reversión automática de resolución. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      ANTES AQUÍ: CERO PERMISOS DE INTERNET A PROPÓSITO.
      Los perfiles viajan dentro del APK y el trabajo lo hacen Shizuku o su, no un
      servidor: no hay llamadas a casa ni cuenta que crear.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      QUERY_ALL_PACKAGES SE QUITÓ EN LA 1.5.0.

      Con él se veían todas las apps, también las que no tienen icono. Pero es un
      permiso que da acceso a la lista completa de programas instalados y que Google
      revisa a mano: no se sostiene para una app que sólo necesita congelar y limpiar
      caché. Se sustituye por <queries>, que es lo que Android recomienda.

      Lo que se pierde, dicho claro: las apps sin icono de lanzador pueden no aparecer
      en la lista de congelar. Está en la pantalla Diagnóstico y en PERMISOS.md.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/reglas_extraccion"
        android:networkSecurityConfig="@xml/red_segura"
        android:theme="@style/TemaReborn">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
